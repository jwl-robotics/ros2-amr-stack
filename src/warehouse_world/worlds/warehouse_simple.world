    <model name="box_stack_3b">
      <static>true</static>
      <pose>-4.5 3 2.6 0 0 0.05</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
