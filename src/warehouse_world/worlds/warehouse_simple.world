      </link>
    </model>

    <!-- Floor-level box near pallet_1 -->
    <model name="box_floor_1">
      <static>true</static>
      <pose>6 -4 0.35 0 0 0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
